<typesystem package="Shiboken" module-uses-gil="false">
    <primitive-type name="bool" />
    <primitive-type name="unsigned long" />
    <primitive-type name="size_t" />
    <add-function signature="isValid(PyObject*)" return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="isvalid"/>
    </add-function>

    <add-function signature="invalidate(PyObject*)">
        <inject-code>
            Shiboken::Object::invalidate(%1);
        </inject-code>
    </add-function>

    <add-function signature="wrapInstance(size_t, PyTypeObject)" return-type="PyObject*">
        <inject-code file="shibokenmodule.cpp" snippet="wrapinstance"/>
    </add-function>

   <add-function signature="getCppPointer(PyObject*)" return-type="PySequence*">
        <inject-code file="shibokenmodule.cpp" snippet="getcpppointer"/>
   </add-function>

   <add-function signature="delete(PyObject*)">
        <inject-code file="shibokenmodule.cpp" snippet="delete"/>
   </add-function>

    <add-function signature="ownedByPython(PyObject*)" return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="ownedbypython"/>
    </add-function>

    <add-function signature="createdByPython(PyObject*)" return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="createdbypython"/>
    </add-function>

    <add-function signature="disassembleFrame(PyObject*)" return-type="PyObject">
        <inject-code file="shibokenmodule.cpp" snippet="disassembleframe"/>
    </add-function>

    <add-function signature="replaceModuleDict(PyObject*, PyObject*, PyObject*)" return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="replacemoduledict"/>
    </add-function>

    <add-function signature="dump(PyObject*)" return-type="const char *">
        <inject-code file="shibokenmodule.cpp" snippet="dump"/>
    </add-function>

    <add-function signature="dumpTree(PyObject*)" return-type="const char *">
        <inject-code file="shibokenmodule.cpp" snippet="dump-tree"/>
    </add-function>

    <add-function signature="getAllValidWrappers(void)" return-type="PySequence*">
        <inject-code file="shibokenmodule.cpp" snippet="getallvalidwrappers"/>
    </add-function>

    <!-- Which binding raw locks this thread holds. Empty in a release build.
         A test uses it from a callback to prove that no lock is held while
         Python runs. -->
    <add-function signature="heldRawLocks()" return-type="const char *">
        <inject-code file="shibokenmodule.cpp" snippet="heldrawlocks"/>
    </add-function>

    <!-- Failpoints: debug builds only, for tests that need two threads in a
         particular order rather than by chance. Always present so a test can
         ask; armFailpoint() answers false when the build has no failpoints. -->
    <add-function signature="armFailpoint(const char *@name@, int @timeoutMs@ = 5000)"
                  return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="armfailpoint"/>
    </add-function>

    <!-- The throwing kind, for a point inside a transaction: it throws where
         an allocation would fail, and disarms itself. -->
    <add-function signature="armFailpointThrow(const char *@name@)"
                  return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="armfailpointthrow"/>
    </add-function>

    <add-function signature="disarmFailpointThrow()">
        <inject-code file="shibokenmodule.cpp" snippet="disarmfailpointthrow"/>
    </add-function>

    <add-function signature="releaseFailpoint(const char *@name@)" return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="releasefailpoint"/>
    </add-function>

    <add-function signature="failpointReached(const char *@name@)" return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="failpointreached"/>
    </add-function>

    <add-function signature="clearFailpoints()">
        <inject-code file="shibokenmodule.cpp" snippet="clearfailpoints"/>
    </add-function>

    <add-function signature="failpointNames()" return-type="const char *">
        <inject-code file="shibokenmodule.cpp" snippet="failpointnames"/>
    </add-function>

    <!-- How many call leases are open on an object. A generated entry point
         takes one before it touches cppSelf and returns it on every exit, so
         a test can assert that no path leaks one. Always 0 with a GIL. -->
    <add-function signature="activeCalls(PyObject*@object@)" return-type="size_t">
        <inject-code file="shibokenmodule.cpp" snippet="activecalls"/>
    </add-function>

    <!-- How often a raw lock was held where the contract says none may be,
         at a place that is a known exception rather than a defect. Today
         that is the lazy-type lock, which spans type creation. -->
    <add-function signature="contractExceptions()" return-type="const char *">
        <inject-code file="shibokenmodule.cpp" snippet="contractexceptions"/>
    </add-function>

    <!-- Which pairs of binding raw locks this run ever held at once, as
         "outer -> inner" lines. The rank is asserted at every acquisition;
         this is what says which nestings actually occur. Empty in a release
         build and in a run that never nested two of them. -->
    <add-function signature="lockNestings()" return-type="const char *">
        <inject-code file="shibokenmodule.cpp" snippet="locknestings"/>
    </add-function>

    <add-function signature="dumpTypeGraph(const char *@fileName@)" return-type="bool">
        <inject-code file="shibokenmodule.cpp" snippet="dumptypegraph"/>
    </add-function>

    <add-function signature="dumpWrapperMap()">
        <inject-code file="shibokenmodule.cpp" snippet="dumpwrappermap"/>
    </add-function>

    <add-function signature="dumpConverters()">
        <inject-code file="shibokenmodule.cpp" snippet="dumpconverters"/>
    </add-function>

    <extra-includes>
        <include file-name="sbkversion.h" location="local"/>
        <include file-name="voidptr.h" location="local"/>
        <include file-name="sbkconverter_p.h" location="local"/>
        <include file-name="sbkfailpoint.h" location="local"/>
    </extra-includes>
     <inject-code position="end" file="shibokenmodule.cpp" snippet="init"/>
</typesystem>
